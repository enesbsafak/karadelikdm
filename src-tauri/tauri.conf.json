{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karadelik Download Manager",
  "mainBinaryName": "karadelikdm",
  "version": "0.1.1",
  "identifier": "dev.karadelik.dm",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Karadelik Download Manager",
        "url": "index.html",
        "width": 1200,
        "height": 740,
        "minWidth": 880,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "enesbsafak",
    "copyright": "© 2026 enesbsafak · MIT",
    "homepage": "https://github.com/enesbsafak/karadelikdm",
    "shortDescription": "Download manager for Windows and macOS",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../extension/chromium/": "extension/chromium"
    },
    "externalBin": [
      "binaries/karadelikdm-nmh"
    ]
  }
}
