{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Karadelik Download Manager pencereleri",
  "windows": [
    "main",
    "prefs",
    "add-*",
    "queues",
    "grabber",
    "zip-*",
    "dialog-*",
    "media-*"
  ],
  "permissions": [
    "core:default",
